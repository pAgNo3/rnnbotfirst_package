<joint name="lw_joint" type="continuous">
  <origin xyz="0.04 0.19 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lwheel_link_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="rw_joint" type="continuous">
  <origin xyz="0.04 -0.04 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rwheel_link_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="lultra_joint" type="fixed">
  <origin xyz="0.25 0.0 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rultrasonic_link_1"/>
</joint>

<joint name="fultra_joint" type="fixed">
  <origin xyz="0.25 0.075 0.025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="fultrasonic_link_1"/>
</joint>

<joint name="rultra_joint" type="fixed">
  <origin xyz="0.25 0.15 0.025" rpy="0 0 0"/>
