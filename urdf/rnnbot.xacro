    <origin xyz="-5.287437154777308e-15 0.015 0.0" rpy="0 0 0"/>
    <mass value="0.21693482671200906"/>
    <inertia ixx="0.000153" iyy="0.000274" izz="0.000153" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
