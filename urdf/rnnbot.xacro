<?xml version="1.0" ?>
<robot name="rnnbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find rnnbot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find rnnbot_description)/urdf/rnnbot.trans" />
<xacro:include filename="$(find rnnbot_description)/urdf/rnnbot.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.12527762536625361 0.07499999999999997 0.024736618472510664" rpy="0 0 0"/>
    <mass value="2.691496900192634"/>
    <inertia ixx="0.005655" iyy="0.014626" izz="0.01912" ixy="-0.0" iyz="-0.0" ixz="5.3e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find rnnbot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find rnnbot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

